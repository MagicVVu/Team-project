P0_MODE=mock
P0_ENGINE=rules
# Independent read-only V1-P1 service: uvicorn p1.app:create_app --factory
# Uses the same service/tool credentials and shared P0 budget ledger.
P1_ENGINE=deepseek
# V1-P2 risk + local knowledge: uvicorn p2.app:create_app --factory
P2_ENGINE=rules
# Optional trusted local rule file; defaults to p2/rules.json.
# P2_RULES_PATH=
# Existing machine configuration is used; never place real secrets in this file.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
DEMO_TOKEN=demo-local
# Required only for P0_MODE=service; backend remains the authenticated public gateway.
AI_SERVICE_TOKEN=
BACKEND_TOOL_TOKEN=
BACKEND_BASE_URL=http://127.0.0.1:8080
