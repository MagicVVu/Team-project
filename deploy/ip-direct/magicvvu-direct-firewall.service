[Unit]
Description=MagicVVu direct TLS source allowlist before Docker NAT
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target docker.service magicvvu-direct.service shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/magicvvu-direct-firewall
ExecReload=/usr/local/sbin/magicvvu-direct-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
