# Candidate host-level gateway. No production installation has been authorized.
# Requires ngx_http_realip_module and Funnel TLS-terminated TCP + PROXY v2.
worker_processes 1;
pid logs/nginx.pid;
error_log logs/error.log warn;
events { worker_connections 256; }
http {
    access_log off; # Never record auth bodies, tokens or account identifiers.
    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    merge_slashes on;
    limit_req_zone $binary_remote_addr zone=login_ip:1m rate=6r/m;
    limit_req_zone $binary_remote_addr zone=all_ip:1m rate=10r/s;
    limit_req_status 429;
    server {
        listen 127.0.0.1:18081 proxy_protocol;
        set_real_ip_from 127.0.0.1;
        real_ip_header proxy_protocol;
        # Only tailscaled on loopback may supply PROXY metadata. No public bind.
        if ($proxy_protocol_addr = "") { return 400; }
        # Proxy only App routes; internal/docs/unknown paths never reach backend.
        location / { return 404; }
        location = /api/v1/ready { return 404; }
        location = /api/v1/auth/register { return 403; }
        location = /api/v1/auth/login {
            limit_req zone=login_ip burst=4 nodelay;
            error_page 429 = @login_limited;
            proxy_pass http://127.0.0.1:8000;
        }
        location /api/v1/ {
            limit_req zone=all_ip burst=20 nodelay;
            proxy_pass http://127.0.0.1:8000;
        }
        location @login_limited {
            default_type application/json;
            add_header Retry-After 10 always;
            add_header Cache-Control no-store always;
            return 429 '{"detail":"Too many login attempts; try again later"}';
        }
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # Do not pass attacker-controlled forwarding/identity claims upstream.
        # Backend intentionally uses its transport peer; real IP limits live here.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header X-MagicVVu-Client-IP "";
        proxy_set_header Tailscale-User-Login "";
        proxy_set_header Tailscale-User-Name "";
        proxy_set_header Tailscale-User-Profile-Pic "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 85s;
    }
}
