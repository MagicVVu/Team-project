{
  "openapi": "3.1.0",
  "info": {
    "title": "Household V1-P0 AI (service)",
    "version": "0.1.0",
    "description": "Read-only AI service; authenticated business backend owns draft storage and all inventory writes."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/agent/message": {
      "post": {
        "summary": "Agent Message",
        "operationId": "agent_message_agent_message_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-User-Id"
            }
          },
          {
            "name": "x-household-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Household-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Message"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "needs_clarification",
              "needs_confirmation",
              "answered",
              "unsupported",
              "error"
            ],
            "title": "Status"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Intent"
              },
              {
                "type": "null"
              }
            ]
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "original_text": {
            "type": "string",
            "title": "Original Text"
          },
          "draft_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft Id"
          },
          "draft": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Command"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Batch"
            },
            "type": "array",
            "title": "Candidates"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Batch"
            },
            "type": "array",
            "title": "Facts"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "manual_entry": {
            "type": "boolean",
            "title": "Manual Entry",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "reply",
          "trace_id",
          "original_text"
        ],
        "title": "AgentResult"
      },
      "Batch": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "household_id": {
            "type": "string",
            "title": "Household Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "purchased_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchased At"
          },
          "label_expiry": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label Expiry"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "FINISHED",
              "REVERSED"
            ],
            "title": "Status",
            "default": "ACTIVE"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "household_id",
          "name",
          "quantity",
          "unit",
          "version"
        ],
        "title": "Batch"
      },
      "Command": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "ADD",
              "CONSUME",
              "PLAN_ADD"
            ],
            "title": "Action"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Unit"
          },
          "batch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Id"
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Version"
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "purchased_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchased At"
          },
          "label_expiry": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label Expiry"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "name",
          "quantity",
          "unit"
        ],
        "title": "Command"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Intent": {
        "type": "string",
        "enum": [
          "ADD",
          "CONSUME",
          "QUERY_INVENTORY",
          "QUERY_LOCATION",
          "PLAN_ADD",
          "UNSUPPORTED"
        ],
        "title": "Intent"
      },
      "Message": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "request_id"
        ],
        "title": "Message"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}