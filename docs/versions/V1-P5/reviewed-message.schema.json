{
  "$defs": {
    "InputProvenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "text",
            "voice",
            "manual_fallback"
          ],
          "title": "Source",
          "type": "string"
        },
        "input_session_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Input Session Id",
          "type": "string"
        },
        "transcript_revision": {
          "minimum": 1,
          "title": "Transcript Revision",
          "type": "integer"
        },
        "user_confirmed": {
          "title": "User Confirmed",
          "type": "boolean"
        },
        "user_edited": {
          "default": false,
          "title": "User Edited",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "input_session_id",
        "transcript_revision",
        "user_confirmed"
      ],
      "title": "InputProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "text": {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Text",
      "type": "string"
    },
    "request_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "household_timezone": {
      "default": "Asia/Shanghai",
      "title": "Household Timezone",
      "type": "string"
    },
    "reminder_days": {
      "default": 3,
      "maximum": 365,
      "minimum": 0,
      "title": "Reminder Days",
      "type": "integer"
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "text",
    "request_id"
  ],
  "title": "Message",
  "type": "object"
}
