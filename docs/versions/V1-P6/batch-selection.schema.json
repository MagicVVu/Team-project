        "review_attestation_received": {
          "title": "Review Attestation Received",
          "type": "boolean"
        },
        "final_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Text Sha256",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "deduplication_owner": {
          "const": "business_backend",
          "default": "business_backend",
          "title": "Deduplication Owner",
          "type": "string"
        }
      },
      "required": [
        "source",
        "review_attestation_received",
        "final_text_sha256",
        "request_fingerprint"
      ],
      "title": "Receipt",
      "type": "object"
    },
