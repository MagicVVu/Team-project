{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "item_key": {
          "title": "Item Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "batches": {
          "items": {
            "$ref": "#/$defs/p2__schemas__Batch"
          },
          "title": "Batches",
          "type": "array"
        }
      },
      "required": [
        "item_key",
        "name",
        "unit",
        "version",
        "batches"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ClarificationContext": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "original_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "household_timezone": {
          "title": "Household Timezone",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "parsed": {
          "$ref": "#/$defs/Parsed"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/p1__schemas__Batch"
