          "default": null,
          "title": "Selected Batch Id"
        },
        "allowed_fields": {
          "items": {
            "enum": [
              "name",
              "quantity",
              "unit",
              "location",
              "purchased_at",
              "label_expiry",
              "opened_at",
              "to_location",
              "batch_id"
