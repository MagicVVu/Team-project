    "InputProvenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "text",
            "voice",
            "manual_fallback"
          ],
          "title": "Source",
          "type": "string"
        },
        "input_session_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Input Session Id",
          "type": "string"
        },
        "transcript_revision": {
          "minimum": 1,
          "title": "Transcript Revision",
          "type": "integer"
        },
        "user_confirmed": {
          "title": "User Confirmed",
          "type": "boolean"
        },
        "user_edited": {
          "default": false,
          "title": "User Edited",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "input_session_id",
        "transcript_revision",
        "user_confirmed"
      ],
      "title": "InputProvenance",
      "type": "object"
    },
    "Intent": {
      "enum": [
        "ADD",
        "CONSUME",
        "QUERY_INVENTORY",
        "QUERY_LOCATION",
        "PLAN_ADD",
        "OPEN",
        "MOVE",
        "DISCARD",
        "UNSUPPORTED"
      ],
      "title": "Intent",
      "type": "string"
    },
    "Parsed": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "purchased_at": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purchased At"
        },
        "label_expiry": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Expiry"
        },
        "opened_at": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opened At"
        },
        "to_location": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Location"
        },
        "discard_mode": {
          "default": "partial",
          "enum": [
            "partial",
            "all"
          ],
          "title": "Discard Mode",
          "type": "string"
        },
        "partial_batch": {
          "default": false,
          "title": "Partial Batch",
          "type": "boolean"
        },
        "multiple_items": {
          "default": false,
          "title": "Multiple Items",
          "type": "boolean"
        },
        "multiple_actions": {
          "default": false,
          "title": "Multiple Actions",
          "type": "boolean"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "intent"
      ],
      "title": "Parsed",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "p5-reviewed-text-1",
          "default": "p5-reviewed-text-1",
          "title": "Policy Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "text",
            "voice",
            "manual_fallback"
          ],
          "title": "Source",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
