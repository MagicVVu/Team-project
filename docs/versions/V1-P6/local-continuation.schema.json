{
  "$defs": {
    "Batch": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "household_id": {
          "title": "Household Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "maximum": 1000000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "unit": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "purchased_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purchased At"
        },
        "label_expiry": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Expiry"
        },
        "opened_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opened At"
        },
        "status": {
          "default": "ACTIVE",
          "enum": [
            "ACTIVE",
            "FINISHED",
            "REVERSED",
            "DISCARDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "category": {
          "default": "unknown",
          "enum": [
            "food",
            "medicine",
            "household",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        },
        "product_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        },
        "label_date_type": {
          "default": "unknown",
          "enum": [
            "use_by",
            "best_before",
            "expiry",
            "unknown"
          ],
          "title": "Label Date Type",
          "type": "string"
        },
        "label_context_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Context Valid"
        },
        "storage_condition": {
          "anyOf": [
            {
              "enum": [
                "ambient",
                "refrigerated",
                "frozen"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Condition"
        },
        "label_storage_condition": {
          "anyOf": [
            {
              "enum": [
                "ambient",
                "refrigerated",
                "frozen"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Storage Condition"
        },
        "is_opened": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Opened"
        }
      },
      "required": [
        "id",
        "household_id",
        "name",
        "quantity",
        "unit",
        "version"
      ],
      "title": "Batch",
      "type": "object"
    },
    "InputProvenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "text",
            "voice",
            "manual_fallback"
          ],
          "title": "Source",
          "type": "string"
        },
        "input_session_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Input Session Id",
          "type": "string"
        },
        "transcript_revision": {
          "minimum": 1,
          "title": "Transcript Revision",
          "type": "integer"
        },
        "user_confirmed": {
          "title": "User Confirmed",
          "type": "boolean"
        },
        "user_edited": {
          "default": false,
          "title": "User Edited",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "input_session_id",
        "transcript_revision",
        "user_confirmed"
      ],
      "title": "InputProvenance",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "p5-reviewed-text-1",
          "default": "p5-reviewed-text-1",
          "title": "Policy Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "text",
            "voice",
            "manual_fallback"
          ],
          "title": "Source",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_attestation_received": {
          "title": "Review Attestation Received",
          "type": "boolean"
        },
        "final_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Text Sha256",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "deduplication_owner": {
          "const": "business_backend",
          "default": "business_backend",
          "title": "Deduplication Owner",
          "type": "string"
        }
      },
      "required": [
        "source",
        "review_attestation_received",
        "final_text_sha256",
        "request_fingerprint"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "title": "User Id",
          "type": "string"
        },
        "household_id": {
          "title": "Household Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "household_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "v1-local-1",
      "default": "v1-local-1",
      "title": "Protocol Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "original_text": {
      "title": "Original Text",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "household_timezone": {
      "title": "Household Timezone",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "kind": {
      "enum": [
        "finish",
        "location"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "location": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location"
    },
    "unlocated": {
      "default": false,
      "title": "Unlocated",
      "type": "boolean"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Batch"
      },
      "maxItems": 1000,
      "title": "Candidates",
      "type": "array"
    },
    "selected_batch_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Batch Id"
    },
    "allowed_fields": {
      "items": {
        "enum": [
          "name",
          "location",
          "batch_id"
        ],
        "type": "string"
      },
      "title": "Allowed Fields",
      "type": "array"
    },
    "input_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Receipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "revision",
    "scope",
    "original_text",
    "request_id",
    "trace_id",
    "household_timezone",
    "created_at",
    "expires_at",
    "kind",
    "allowed_fields"
  ],
  "title": "LocalContext",
  "type": "object"
}
