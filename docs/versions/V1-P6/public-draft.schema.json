            }
          ],
          "default": null,
          "title": "Location"
        },
        "purchased_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purchased At"
        },
        "label_expiry": {
          "anyOf": [
            {
              "format": "date",
