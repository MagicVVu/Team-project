    "draft": {
      "discriminator": {
        "mapping": {
          "ADD": "#/$defs/AddCommand",
          "CONSUME": "#/$defs/ConsumeCommand",
          "DISCARD": "#/$defs/DiscardCommand",
          "MOVE": "#/$defs/MoveCommand",
          "OPEN": "#/$defs/OpenCommand",
          "PLAN_ADD": "#/$defs/PlanCommand"
        },
        "propertyName": "action"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AddCommand"
        },
        {
          "$ref": "#/$defs/PlanCommand"
        },
        {
          "$ref": "#/$defs/ConsumeCommand"
        },
        {
