        "opened_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opened At"
        },
        "status": {
          "default": "ACTIVE",
          "enum": [
            "ACTIVE",
            "FINISHED",
            "REVERSED",
            "DISCARDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
