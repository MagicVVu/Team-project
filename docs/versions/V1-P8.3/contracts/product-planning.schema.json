{
  "$defs": {
    "AggregateBatch": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "title": "Batch Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "quantity": {
          "anyOf": [
            {
              "maximum": 1000000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "unit": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "base_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Quantity"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Location"
        },
        "label_expiry": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label Expiry"
        },
        "opened_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Opened At"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "FINISHED",
            "REVERSED",
            "DISCARDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "expired": {
          "title": "Expired",
          "type": "boolean"
        },
        "expiry_known": {
          "title": "Expiry Known",
          "type": "boolean"
        },
        "facts_version": {
          "minimum": 0,
          "title": "Facts Version",
          "type": "integer"
        },
        "stock_verification": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stock Verification"
        },
        "mapping_status": {
          "const": "household_attested",
          "title": "Mapping Status",
          "type": "string"
        }
      },
      "required": [
        "batch_id",
        "version",
        "quantity",
        "unit",
        "base_quantity",
        "location",
        "label_expiry",
        "opened_at",
        "status",
        "expired",
        "expiry_known",
        "facts_version",
        "stock_verification",
        "mapping_status"
      ],
      "title": "AggregateBatch",
      "type": "object"
    },
    "Product": {
      "additionalProperties": true,
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "item_key": {
          "title": "Item Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "specification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Specification"
        },
        "base_unit": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Base Unit",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "identity_status": {
          "const": "household_attested",
          "title": "Identity Status",
          "type": "string"
        },
        "tag_source": {
          "const": "household_attested",
          "title": "Tag Source",
          "type": "string"
        },
        "platform_rule_review_status": {
          "title": "Platform Rule Review Status",
          "type": "string"
        },
        "batches": {
          "items": {
            "$ref": "#/$defs/AggregateBatch"
          },
          "maxItems": 1000,
          "title": "Batches",
          "type": "array"
        },
        "quantity_complete": {
          "title": "Quantity Complete",
          "type": "boolean"
        },
        "total_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Quantity"
        },
        "nonexpired_active_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nonexpired Active Quantity"
        },
        "usable_quantity": {
          "title": "Usable Quantity",
          "type": "null"
        },
        "consumption_coverage_days": {
          "title": "Consumption Coverage Days",
          "type": "null"
        },
        "version_token": {
          "minLength": 1,
          "title": "Version Token",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "item_key",
        "name",
        "specification",
        "base_unit",
        "category",
        "version",
        "identity_status",
        "tag_source",
        "platform_rule_review_status",
        "batches",
        "quantity_complete",
        "total_quantity",
        "nonexpired_active_quantity",
        "usable_quantity",
        "consumption_coverage_days",
        "version_token"
      ],
      "title": "Product",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "product": {
      "$ref": "#/$defs/Product"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "window_start": {
      "format": "date",
      "title": "Window Start",
      "type": "string"
    },
    "window_end_exclusive": {
      "format": "date",
      "title": "Window End Exclusive",
      "type": "string"
    },
    "recorded_consumption_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recorded Consumption Quantity"
    },
    "recorded_consumption_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Recorded Consumption Event Ids",
      "type": "array"
    },
    "pending_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pending Quantity"
    },
    "forecast_status": {
      "const": "unavailable",
      "default": "unavailable",
      "title": "Forecast Status",
      "type": "string"
    },
    "remaining_days": {
      "default": null,
      "title": "Remaining Days",
      "type": "null"
    },
    "reference_date": {
      "default": null,
      "title": "Reference Date",
      "type": "null"
    },
    "suggested_quantity": {
      "default": null,
      "title": "Suggested Quantity",
      "type": "null"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "product",
    "as_of",
    "window_start",
    "window_end_exclusive",
    "recorded_consumption_quantity",
    "recorded_consumption_event_ids",
    "pending_quantity",
    "reason_codes"
  ],
  "title": "ProductPlanning",
  "type": "object"
}
