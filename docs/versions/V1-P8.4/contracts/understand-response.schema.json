{
  "$defs": {
    "FieldSource": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 120,
          "title": "Value",
          "type": "string"
        },
        "source": {
          "default": "current_text",
          "enum": [
            "current_text",
            "current_task"
          ],
          "title": "Source",
          "type": "string"
        },
        "quote": {
          "default": "",
          "maxLength": 1000,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "FieldSource",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "speech_act": {
          "enum": [
            "request",
            "discuss",
            "hypothesis",
            "negation",
            "correction",
            "supplement",
            "question",
            "social",
            "status",
            "basis",
            "recall",
            "new_task"
          ],
          "title": "Speech Act",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/Selector"
        },
        "reads": {
          "items": {
            "$ref": "#/$defs/Read"
          },
          "maxItems": 4,
          "title": "Reads",
          "type": "array"
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "ADD",
                "CONSUME",
                "OPEN",
                "MOVE",
                "DISCARD",
                "PLAN_ADD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldSource"
          },
          "maxProperties": 8,
          "title": "Fields",
          "type": "object"
        },
        "amount_mode": {
          "default": "literal",
          "enum": [
            "literal",
            "half",
            "all",
            "unknown"
          ],
          "title": "Amount Mode",
          "type": "string"
        },
        "write_count": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Write Count",
          "type": "integer"
        },
        "task_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Index"
        },
        "preserve_active": {
          "default": true,
          "title": "Preserve Active",
          "type": "boolean"
        },
        "social_reply": {
          "anyOf": [
            {
              "maxLength": 800,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Social Reply"
        }
      },
      "required": [
        "speech_act"
      ],
      "title": "Plan",
      "type": "object"
    },
    "Read": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "quantity",
            "location",
            "dates",
            "risk",
            "consumption",
            "forecast",
            "purchase"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Read",
      "type": "object"
    },
    "Selector": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "choice_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choice Index"
        },
        "use_reference": {
          "default": false,
          "title": "Use Reference",
          "type": "boolean"
        }
      },
      "title": "Selector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "p84-dialogue-1",
      "default": "p84-dialogue-1",
      "title": "Protocol Version",
      "type": "string"
    },
    "original_text": {
      "title": "Original Text",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/Plan"
    },
    "understanding_calls": {
      "maximum": 1,
      "minimum": 0,
      "title": "Understanding Calls",
      "type": "integer"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "original_text",
    "plan",
    "understanding_calls"
  ],
  "title": "Understood",
  "type": "object"
}
