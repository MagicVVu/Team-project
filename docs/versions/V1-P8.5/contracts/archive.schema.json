{
  "$defs": {
    "ObjectReference": {
      "additionalProperties": false,
      "description": "Attestation from an authenticated business caller, never a phone fact.",
      "properties": {
        "protocol_version": {
          "const": "p7-object-reference-1",
          "default": "p7-object-reference-1",
          "title": "Protocol Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_task_id": {
          "format": "uuid",
          "title": "Source Task Id",
          "type": "string"
        },
        "source_revision": {
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        },
        "batch_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "source_task_id",
        "source_revision",
        "batch_id",
        "issued_at",
        "expires_at"
      ],
      "title": "ObjectReference",
      "type": "object"
    },
    "P85Episode": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "reply": {
          "default": "",
          "maxLength": 8000,
          "title": "Reply",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/P85Subject"
          },
          "maxItems": 4,
          "title": "Subjects",
          "type": "array"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "memory_id",
        "request_id",
        "text",
        "created_at"
      ],
      "title": "P85Episode",
      "type": "object"
    },
    "P85Subject": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "quote": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "name",
        "quote"
      ],
      "title": "P85Subject",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "title": "User Id",
          "type": "string"
        },
        "household_id": {
          "title": "Household Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "household_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "conversation-episodes-1",
      "default": "conversation-episodes-1",
      "title": "Protocol Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/P85Episode"
      },
      "maxItems": 100,
      "title": "Episodes",
      "type": "array"
    },
    "has_more": {
      "default": false,
      "title": "Has More",
      "type": "boolean"
    }
  },
  "required": [
    "scope",
    "conversation_id",
    "revision"
  ],
  "title": "P85Archive",
  "type": "object"
}
