  "actual_unit_definitions": "# /etc/systemd/system/magicvvu-direct.service\n[Unit]\nDescription=MagicVVu existing Compose stack with direct TLS\nRequires=docker.service\nAfter=docker.service network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nWorkingDirectory=/srv/magicvvu/magicvvu-starter/deploy\nExecStart=/usr/bin/docker compose up -d --no-recreate\nExecReload=/usr/bin/docker compose restart backend\nRemainAfterExit=yes\nTimeoutStartSec=120\n\n[Install]\nWantedBy=multi-user.target\n\n# /etc/systemd/system/magicvvu-direct-renew.timer\n[Unit]\nDescription=Daily MagicVVu internal certificate expiry check\n\n[Timer]\nOnCalendar=daily\nRandomizedDelaySec=1800\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n\n# /etc/systemd/system/magicvvu-direct-renew.service\n[Unit]\nDescription=Renew MagicVVu internal IP TLS leaf certificate\nAfter=magicvvu-direct.service\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/python3 /etc/magicvvu/ip-direct/renew.py\nUser=root\n",
